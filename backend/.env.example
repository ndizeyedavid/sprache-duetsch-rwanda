DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

PORT=4000
NODE_ENV=development

JWT_SECRET="CHANGE-ME-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE-ME-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

CORS_ORIGINS="http://localhost:5173,http://localhost:5174,https://class.deutschspracherw.org,https://deutschspracherw.org,https://www.deutschspracherw.org"

BCRYPT_ROUNDS=10
LOG_LEVEL="info"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30

ATTENDANCE_ALERT_THRESHOLD=75

UNPAID_ACCESS="LIMITED"

# Production: https://class.deutschspracherw.org (links in emails, certificate QR codes, setup links).
PUBLIC_APP_URL="http://localhost:5173"

REMINDERS_ENABLED="true"
REMINDER_TIMEZONE="Africa/Kigali"

SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="CHANGE-ME-12-chars-min"

# Google sign-in is disabled unless GOOGLE_AUTH_ENABLED="true".
GOOGLE_AUTH_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP — Zoho Mail (info@deutshsprache.org). Zoho requires SMTP_FROM to use the signed-in address.
# If 2-factor login is turned on for the mailbox, use a Zoho app-specific password here.
# On Render set these as Environment Variables (no quotes needed). In a local .env file keep SMTP_FROM quoted.
SMTP_HOST="smtp.zoho.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="info@deutshsprache.org"
SMTP_PASS=""
SMTP_FROM="Deutsch Sprache RW <info@deutshsprache.org>"
# VPS relay — HTTP forwarder so Render can send email via your Ubuntu VPS (bypasses Render SMTP block)
# e.g. https://mail.deutshsprache.org  or http://YOUR_VPS_IP:3001  (see email-relay/README.md)
EMAIL_RELAY_URL=""
EMAIL_RELAY_SECRET="change-me-long-random-string"

# Optional: extra origins for public enrollment endpoint (already includes the two enrollment sites by default)
ENROLLMENT_ALLOWED_ORIGINS="https://deutschspracherw.org,https://www.deutschspracherw.org"

# Paypack: leave disabled until credentials and the public webhook are configured.
PAYPACK_ENABLED=false
PAYPACK_CLIENT_ID=
PAYPACK_CLIENT_SECRET=
PAYPACK_WEBHOOK_SECRET=
PAYPACK_WEBHOOK_MODE=development
