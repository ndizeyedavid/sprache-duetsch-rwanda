# Copy to .env and fill in. Never commit a real .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

PORT=4000
NODE_ENV=development

# Min 32 random chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE-ME-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE-ME-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

CORS_ORIGINS="http://localhost:5173"

BCRYPT_ROUNDS=10
LOG_LEVEL="info"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30

# Attendance % below which students get a low-attendance alert.
ATTENDANCE_ALERT_THRESHOLD=75
# How unpaid/overdue students are treated: FULL | LIMITED | NONE.
UNPAID_ACCESS="LIMITED"

# Public frontend URL — embedded in certificate QR codes.
PUBLIC_APP_URL="http://localhost:5173"

# Reminder scheduler (node-cron): "false" disables all jobs.
REMINDERS_ENABLED="true"
REMINDER_TIMEZONE="Africa/Kigali"

SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="CHANGE-ME-12-chars-min"
