DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

PORT=4000
NODE_ENV=development

JWT_SECRET="CHANGE-ME-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE-ME-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

CORS_ORIGINS="http://localhost:5173,http://localhost:5174,https://deutsch-prache-rw.vercel.app,https://www.deutshsprache.org"

BCRYPT_ROUNDS=10
LOG_LEVEL="info"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30

ATTENDANCE_ALERT_THRESHOLD=75

UNPAID_ACCESS="LIMITED"

PUBLIC_APP_URL="http://localhost:5173"

REMINDERS_ENABLED="true"
REMINDER_TIMEZONE="Africa/Kigali"

SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="CHANGE-ME-12-chars-min"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP — Gmail App Password (https://myaccount.google.com/apppasswords)
# Use an App Password, not your Gmail password. Requires 2-Step Verification.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="Deutsch Sprache RW <you@gmail.com>"
# Optional: extra origins for public enrollment endpoint (already includes the two enrollment sites by default)
ENROLLMENT_ALLOWED_ORIGINS="https://deutsch-prache-rw.vercel.app,https://www.deutshsprache.org"
