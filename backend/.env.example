DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"

PORT=4000
NODE_ENV=development

JWT_SECRET="CHANGE-ME-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="CHANGE-ME-min-32-chars"
JWT_REFRESH_EXPIRES_IN="30d"

CORS_ORIGINS="http://localhost:5173,http://localhost:5174,https://class.deutschspracherw.org,https://deutschspracherw.org,https://www.deutschspracherw.org"

BCRYPT_ROUNDS=10
LOG_LEVEL="info"

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=30

ATTENDANCE_ALERT_THRESHOLD=75

UNPAID_ACCESS="LIMITED"

# Production: https://class.deutschspracherw.org (links in emails, certificate QR codes, setup links).
PUBLIC_APP_URL="http://localhost:5173"

REMINDERS_ENABLED="true"
REMINDER_TIMEZONE="Africa/Kigali"

SEED_SUPERADMIN_EMAIL="admin@example.com"
SEED_SUPERADMIN_PASSWORD="CHANGE-ME-12-chars-min"

# Google sign-in is disabled unless GOOGLE_AUTH_ENABLED="true".
GOOGLE_AUTH_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP — Hubmail (mail.hubmail.space:587, STARTTLS) for deutschspracherw.org. SMTP_SECURE=false means STARTTLS on 587.
# SMTP_USER is the Hubmail credential id; SMTP_FROM must be an address on the verified domain. Keep SMTP_FROM quoted locally.
SMTP_HOST="mail.hubmail.space"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Deutsch Sprache RW <info@deutschspracherw.org>"

# Optional: extra origins for public enrollment endpoint (already includes the two enrollment sites by default)
ENROLLMENT_ALLOWED_ORIGINS="https://deutschspracherw.org,https://www.deutschspracherw.org"

# XendlyPay mobile money (see XENDLYPAY.md). Webhook URL to register in the XendlyPay app:
#   https://class.deutschspracherw.org/api/payments/xendlypay/webhook
# XENDLYPAY_MODE must match the app's mode (test|live); payments in another mode are never credited.
XENDLYPAY_ENABLED=false
XENDLYPAY_API_KEY=
XENDLYPAY_WEBHOOK_SECRET=
XENDLYPAY_MODE=test
