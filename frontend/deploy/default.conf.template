# The platform has one public address: class.deutschspracherw.org. Page requests on any other hostname
# (the retired class.deutshsprache.org, the Hubfly default *.hubfly.app host, or any domain attached later)
# move there permanently, path and query kept, so bookmarks, emailed links and printed QR codes keep working.
# Internal callers (health checks, the Hubfly network, IP addresses, local testing) are never redirected.
map $host $send_to_canonical {
    default                              1;
    class.deutschspracherw.org           0;
    ""                                   0;
    localhost                            0;
    "~^[0-9.]+$"                         0;
    "~:"                                 0;
    "~\.hubfly\.internal$"               0;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 27m;

    # Compress text assets: phones on slow networks are the main audience.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 6;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json text/plain;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://${BACKEND_HOST}:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $http_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_read_timeout 90s;
    }

    # nginx's default MIME map has no .mjs entry, so module scripts (the PDF.js worker)
    # were sent as application/octet-stream and browsers refused to run them.
    # A regex location wins over the /assets/ prefix for these files only.
    location ~* \.mjs$ {
        types { }
        default_type application/javascript;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Service-worker plumbing is served on every hostname (never redirected): a browser with
    # the old site installed must be able to fetch the new worker, whose index.html then
    # sends the tab to the new hostname. A redirected worker script would fail to update.
    location ~ ^/(sw\.js|registerSW\.js|workbox-[A-Za-z0-9_-]+\.js|manifest\.webmanifest|index\.html)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Course audio (pre-generated MP3s): the URL is a hash of voice + text, so it never changes;
    # a missing clip must 404 (the player then uses the device voice), never fall back to index.html.
    location /audio/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        if ($send_to_canonical) {
            return 301 https://class.deutschspracherw.org$request_uri;
        }
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
